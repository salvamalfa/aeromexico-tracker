{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeromexico-tracker/contracts/web/analysis.schema.json",
  "title": "Análisis del Analysis Agent para la lectura ejecutiva (v1)",
  "description": "Describes web/public/data/v1/analysis/<period_id>.json: exactly the fields src.analysis_agent.lifecycle.consumer_payload(record) authorizes for a currently-approved analysis version, minus any reader-private section (see src/web_export/analysis.py). No calculation lineage, evidence excerpts or source URLs — those stay private; the citations the published HTML overlays on top of this text are out of scope for this export. See docs/arquitectura/auditoria-arquitectura-20260926.md Fase 3 and contracts/web/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period_id", "version", "content_hash", "thesis", "summary",
    "summary_format", "summary_items", "sections", "claims",
    "evidence_fingerprint", "package_id", "approval_event", "audit_hash",
    "version_event_head", "context"
  ],
  "properties": {
    "period_id": { "type": "string", "pattern": "^\\d{4}Q[1-4]$" },
    "version": { "type": "string" },
    "content_hash": { "type": "string" },
    "thesis": { "type": "string" },
    "summary": { "type": "array", "items": { "type": "string" } },
    "summary_format": { "type": "string" },
    "summary_items": { "type": "array", "items": { "$ref": "#/$defs/summary_item" } },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "evidence_fingerprint": { "type": "string" },
    "package_id": { "type": "string" },
    "approval_event": { "type": "string" },
    "audit_hash": { "type": "string" },
    "version_event_head": { "type": "string" },
    "context": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "summary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "lead", "emphasis", "text"],
      "properties": {
        "claim_id": { "type": "string" },
        "lead": { "type": ["string", "null"] },
        "emphasis": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string" },
        "paragraphs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "type", "text", "calculation_ids", "evidence_ids"],
      "properties": {
        "claim_id": { "type": "string" },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "calculation_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
