{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarterly means of verified fare observations",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "fare_averages_v1"
    },
    "period_basis": {
      "const": "consultation_quarter_America_Mexico_City"
    },
    "aggregation": {
      "const": "arithmetic_mean_of_verified_observations_not_all_flights"
    },
    "periods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{4}Q[1-4]$"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period_id",
          "provider",
          "origin",
          "destination",
          "origin_map_id",
          "destination_map_id",
          "fare",
          "conditions",
          "horizon_months",
          "stay_days",
          "trip_type",
          "observations",
          "paired_cash_points",
          "query_date_start",
          "query_date_end",
          "points_applicability",
          "group_id",
          "metrics"
        ],
        "properties": {
          "period_id": {
            "type": "string",
            "pattern": "^\\d{4}Q[1-4]$"
          },
          "provider": {
            "enum": [
              "AMR",
              "DOTERS",
              "VOLARIS"
            ]
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "origin_map_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "destination_map_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "fare": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "string",
            "minLength": 1
          },
          "horizon_months": {
            "type": "integer",
            "minimum": 0
          },
          "stay_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "trip_type": {
            "enum": [
              "round_trip",
              "one_way"
            ]
          },
          "observations": {
            "type": "integer",
            "minimum": 1
          },
          "paired_cash_points": {
            "type": "integer",
            "minimum": 0
          },
          "query_date_start": {
            "type": "string",
            "format": "date"
          },
          "query_date_end": {
            "type": "string",
            "format": "date"
          },
          "points_applicability": {
            "enum": [
              "applicable",
              "not_applicable"
            ]
          },
          "group_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cash_final_mxn",
              "points",
              "redemption_cash_mxn",
              "redemption_taxes_mxn"
            ],
            "properties": {
              "cash_final_mxn": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mean",
                  "n"
                ],
                "properties": {
                  "mean": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "points": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mean",
                  "n"
                ],
                "properties": {
                  "mean": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "redemption_cash_mxn": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mean",
                  "n"
                ],
                "properties": {
                  "mean": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "redemption_taxes_mxn": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mean",
                  "n"
                ],
                "properties": {
                  "mean": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "excluded_unverified_observations": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "period_basis",
    "aggregation",
    "periods",
    "groups",
    "excluded_unverified_observations",
    "notes",
    "dataset_version"
  ]
}
