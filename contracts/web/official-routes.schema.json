{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeromexico-tracker/contracts/web/official-routes.schema.json",
  "title": "OfficialRouteNetwork",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "metadata", "periods", "carriers", "sources", "networks"],
  "properties": {
    "schema_version": {"const": "official_route_network_v1"},
    "dataset_version": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "universe", "source_as_of", "notes", "geography_attribution"],
      "properties": {
        "title": {"const": "Vuelos regulares"},
        "universe": {"const": "scheduled_passenger_and_all_cargo"},
        "source_as_of": {"type": "string"}, "notes": {"type": "array", "items": {"type": "string"}},
        "geography_attribution": {"type": "string"}
      }
    },
    "periods": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^20[0-9]{2}Q[1-4]$"}},
    "carriers": {"type": "array", "items": {"type": "object", "required": ["key", "label", "operator_ids"], "properties": {
      "key": {"$ref": "#/$defs/carrierKey"}, "label": {"type": "string"},
      "operator_ids": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": false}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "networks": {"type": "array", "items": {"$ref": "#/$defs/network"}}
  },
  "$defs": {
    "carrierKey": {"enum": ["AEROMEXICO", "VOLARIS", "VIVA_AEROBUS"]},
    "months": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^20[0-9]{2}M(0[1-9]|1[0-2])$"}},
    "count": {"type": "integer", "minimum": 0},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "url", "source_period", "captured_at", "sha256"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"}, "url": {"type": "string"},
        "source_period": {"type": "string"}, "captured_at": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "country_iso2", "lat", "lon", "point_kind"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "country_iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "point_kind": {"enum": ["city", "airport"]}, "iata": {"type": "string", "pattern": "^[A-Z0-9]{3}$"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_departures", "yoy_pct", "comparison_months", "reason"],
      "properties": {
        "previous_departures": {"type": ["integer", "null"], "minimum": 0},
        "yoy_pct": {"type": ["number", "null"]},
        "comparison_months": {"$ref": "#/$defs/months"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["route_key", "origin", "destination", "region", "departures", "monthly", "directions", "operators", "comparison"],
      "properties": {
        "route_key": {"type": "string"}, "origin": {"$ref": "#/$defs/point"}, "destination": {"$ref": "#/$defs/point"},
        "region": {"enum": [null, "canada", "central_america_caribbean", "south_america", "europe", "asia"]},
        "departures": {"$ref": "#/$defs/count"},
        "monthly": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["period_id", "departures"], "properties": {"period_id": {"type": "string"}, "departures": {"$ref": "#/$defs/count"}}}},
        "directions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["origin_id", "destination_id", "departures"], "properties": {
            "origin_id": {"type": "string"}, "destination_id": {"type": "string"}, "departures": {"$ref": "#/$defs/count"}}}},
        "operators": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["carrier_key", "carrier_group", "label", "airline_id", "departures"], "properties": {
            "carrier_key": {"type": "string"}, "carrier_group": {"$ref": "#/$defs/carrierKey"},
            "label": {"type": "string"}, "airline_id": {"type": "string"}, "departures": {"$ref": "#/$defs/count"}}}},
        "comparison": {"$ref": "#/$defs/comparison"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["period_id", "scope", "entity", "carrier_keys", "grain", "expected_months", "observed_months", "availability", "source_ids", "notes", "routes"],
      "properties": {
        "period_id": {"type": "string"}, "scope": {"enum": ["national", "us", "international"]},
        "entity": {"type": "string"}, "carrier_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/carrierKey"}},
        "grain": {"enum": ["city_pair", "airport_pair"]},
        "expected_months": {"$ref": "#/$defs/months"}, "observed_months": {"$ref": "#/$defs/months"},
        "availability": {"enum": ["complete", "partial", "unavailable"]},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}
      }
    }
  }
}
