{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved public monthly news v1; candidates excluded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "coverage_note",
    "months",
    "records",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "monthly_news_v1"
    },
    "mode": {
      "enum": [
        "approved_only",
        "evidence_unavailable"
      ]
    },
    "coverage_note": {
      "type": "string"
    },
    "approved_index_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "type": "null"
    },
    "approval_package": {
      "type": "null"
    },
    "default_month": {
      "type": [
        "string",
        "null"
      ]
    },
    "months": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "story_id",
          "title",
          "description",
          "companies",
          "topics",
          "publisher",
          "published_at",
          "event_date",
          "event_end_date",
          "first_captured_at",
          "sources",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "story_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "companies": {
            "type": "array",
            "items": {
              "enum": [
                "Aeroméxico",
                "Aeroméxico Connect",
                "Viva",
                "Volaris"
              ]
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publisher": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "event_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_end_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_captured_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "url",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^/@]+/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "review_status": {
            "const": "owner_approved"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "evidence_unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "maxItems": 0
          },
          "months": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
