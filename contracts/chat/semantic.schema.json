{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeromexico-tracker/contracts/chat/semantic.schema.json",
  "title": "Catálogo semántico del Airline Tracker chat",
  "type": "object",
  "required": ["entities", "metrics", "question_examples"],
  "additionalProperties": false,
  "properties": {
    "entities": {"type": "object", "required": ["metadata", "entities"], "properties": {"metadata": {"type": "object", "required": ["catalog_version", "owner", "review_status", "effective_from"], "properties": {"catalog_version": {"type": "string"}, "owner": {"type": "string"}, "review_status": {"type": "string"}, "effective_from": {"type": "string"}}, "additionalProperties": false}, "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}}, "additionalProperties": false},
    "metrics": {"type": "object", "required": ["metadata", "metrics", "periods", "inventory_not_enabled"], "properties": {"metadata": {"type": "object", "required": ["catalog_version", "owner", "review_status", "effective_from"], "properties": {"catalog_version": {"type": "string"}, "owner": {"type": "string"}, "review_status": {"type": "string"}, "effective_from": {"type": "string"}}, "additionalProperties": false}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}}, "periods": {"type": "object"}, "inventory_not_enabled": {"type": "array", "items": {"type": "object", "required": ["id", "label", "field", "unit", "grain", "coverage", "why_not_enabled"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "field": {"type": "string"}, "unit": {"type": "object"}, "grain": {"type": "string"}, "coverage": {"type": "object"}, "why_not_enabled": {"type": "string"}}, "additionalProperties": true}}}, "additionalProperties": false},
    "question_examples": {"type": "object", "required": ["examples"], "properties": {"examples": {"type": "array", "items": {"type": "object", "required": ["question", "metric_ids", "operation", "verified"], "properties": {"question": {"type": "string"}, "metric_ids": {"type": "array", "items": {"type": "string"}}, "operation": {"type": "string"}, "verified": {"type": "boolean"}}, "additionalProperties": true}}}, "additionalProperties": false}
  },
  "$defs": {
    "entity": {"type": "object", "required": ["id", "label", "aliases", "grain", "definition", "availability"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "grain": {"type": "string"}, "definition": {"type": "string"}, "availability": {"type": "object"}, "members": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "metric": {"type": "object", "required": ["id", "label", "description", "aliases", "unit", "grain", "source", "field", "calculation", "aggregation", "weighting", "dimensions", "period_grains", "coverage", "absence", "quality", "references", "owner", "review_status", "effective_from"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "description": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "unit": {"type": "object"}, "grain": {"type": "string"}, "source": {"type": "array", "items": {"type": "string"}}, "field": {"type": "string"}, "calculation": {"type": "string"}, "aggregation": {"type": "string"}, "weighting": {"type": "string"}, "dimensions": {"type": "array", "items": {"type": "string"}}, "period_grains": {"type": "array", "items": {"type": "string", "enum": ["month", "quarter"]}}, "coverage": {"type": "object"}, "absence": {"type": "string"}, "quality": {"type": "string"}, "references": {"type": "array", "items": {"type": "string"}}, "owner": {"type": "string"}, "review_status": {"type": "string"}, "effective_from": {"type": "string"}}, "additionalProperties": true}
  }
}
