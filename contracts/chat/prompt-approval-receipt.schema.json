{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airline-tracker.example/contracts/chat/prompt-approval-receipt.schema.json",
  "title": "Chat prompt owner approval receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "version",
    "prompt_sha256",
    "prompt_path",
    "capabilities",
    "decision_ref",
    "owner",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "owner_approved"
    },
    "version": {
      "const": "r2-proposed"
    },
    "prompt_sha256": {
      "const": "cec193aa10dff802d5578da00777b5b56c74bfcc71aeccaf1ea718c07cc763b1"
    },
    "prompt_path": {
      "const": "config/chat/prompt_candidates/system_prompt_r2-proposed.txt"
    },
    "capabilities": {
      "const": [
        "route_queries",
        "business_metric_queries",
        "evidence_search",
        "same_turn_displays",
        "three_layer_causal_explanations"
      ]
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
