{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.amr/worker-assignment.schema.json",
  "title": "AMR worker assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "control_row",
    "order",
    "region",
    "destination",
    "months",
    "query_date",
    "departure_date",
    "return_date",
    "date_shift_days",
    "base_departure_date",
    "base_return_date",
    "browser_lane",
    "clean_url"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^AMR-[0-9]{8}-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "control_row": { "type": "integer", "minimum": 2 },
    "order": { "type": "integer", "minimum": 1 },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "destination": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "months": { "enum": [1, 3, 6] },
    "query_date": { "$ref": "#/$defs/date" },
    "departure_date": { "$ref": "#/$defs/date" },
    "return_date": { "$ref": "#/$defs/date" },
    "date_shift_days": { "enum": [0, 1] },
    "base_departure_date": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "base_return_date": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "browser_lane": { "type": "string", "minLength": 1 },
    "clean_url": {
      "type": "string",
      "pattern": "^https://www\\.aeromexico\\.com/bf/es-mx/reserva/opciones\\?itinerary=MEX_[A-Z]{3}_[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[A-Z]{3}_MEX_[0-9]{4}-[0-9]{2}-[0-9]{2}&amrpoints=true&leg=1&travelers=A1_C0_I0_PH0_PC0$"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "date_shift_days": { "const": 0 } } },
      "then": {
        "properties": {
          "base_departure_date": { "type": "null" },
          "base_return_date": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "date_shift_days": { "const": 1 } } },
      "then": {
        "properties": {
          "base_departure_date": { "$ref": "#/$defs/date" },
          "base_return_date": { "$ref": "#/$defs/date" }
        }
      }
    }
  ]
}
