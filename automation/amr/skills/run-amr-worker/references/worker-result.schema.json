{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.amr/worker-result.schema.json",
  "title": "AMR worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "region",
    "browser_lane",
    "worker_status",
    "worker_error",
    "cleanup_status",
    "cleanup_error",
    "job"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^AMR-[0-9]{8}-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "browser_lane": { "type": "string", "minLength": 1 },
    "worker_status": { "enum": ["ok", "error"] },
    "worker_error": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "cleanup_status": { "enum": ["ok", "error"] },
    "cleanup_error": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "job": { "$ref": "#/$defs/job" }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}$"
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "number": { "type": "number", "minimum": 0 },
    "cabin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outbound_fare",
        "return_fare",
        "outbound_time",
        "return_time",
        "promotion",
        "carrier_points",
        "award_taxes_mxn",
        "cash_carrier_mxn",
        "cash_taxes_mxn",
        "points_accrual"
      ],
      "properties": {
        "outbound_fare": { "const": "Clasica" },
        "return_fare": { "const": "Clasica" },
        "outbound_time": { "$ref": "#/$defs/time" },
        "return_time": { "$ref": "#/$defs/time" },
        "promotion": { "enum": ["Si", "No"] },
        "carrier_points": { "$ref": "#/$defs/number" },
        "award_taxes_mxn": { "$ref": "#/$defs/number" },
        "cash_carrier_mxn": { "$ref": "#/$defs/number" },
        "cash_taxes_mxn": { "$ref": "#/$defs/number" },
        "points_accrual": { "$ref": "#/$defs/number" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_row",
        "order",
        "destination",
        "months",
        "query_date",
        "departure_date",
        "return_date",
        "date_shift_days",
        "status",
        "error",
        "main",
        "premier"
      ],
      "properties": {
        "control_row": { "type": "integer", "minimum": 2 },
        "order": { "type": "integer", "minimum": 1 },
        "destination": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "months": { "enum": [1, 3, 6] },
        "query_date": { "$ref": "#/$defs/date" },
        "departure_date": { "$ref": "#/$defs/date" },
        "return_date": { "$ref": "#/$defs/date" },
        "date_shift_days": { "enum": [0, 1] },
        "status": { "enum": ["ok", "partial", "error"] },
        "error": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "main": { "oneOf": [{ "$ref": "#/$defs/cabin" }, { "type": "null" }] },
        "premier": { "oneOf": [{ "$ref": "#/$defs/cabin" }, { "type": "null" }] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "cleanup_status": { "const": "ok" } } },
      "then": { "properties": { "cleanup_error": { "type": "null" } } },
      "else": { "properties": { "cleanup_error": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "worker_status": { "const": "error" } } },
      "then": {
        "properties": {
          "worker_error": { "type": "string", "minLength": 1 },
          "job": {
            "properties": {
              "status": { "const": "error" },
              "error": { "type": "string", "minLength": 1 },
              "main": { "type": "null" },
              "premier": { "type": "null" }
            }
          }
        }
      },
      "else": { "properties": { "worker_error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "job": { "properties": { "status": { "const": "ok" } } } } },
      "then": {
        "properties": {
          "worker_status": { "const": "ok" },
          "worker_error": { "type": "null" },
          "job": {
            "properties": {
              "error": { "type": "null" },
              "main": { "$ref": "#/$defs/cabin" },
              "premier": { "$ref": "#/$defs/cabin" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "job": { "properties": { "status": { "const": "partial" } } } } },
      "then": {
        "properties": {
          "worker_status": { "const": "ok" },
          "worker_error": { "type": "null" },
          "job": {
            "properties": {
              "error": {
                "type": "string",
                "enum": ["Main: No disponible", "Premier: No disponible"]
              }
            },
            "oneOf": [
              {
                "properties": {
                  "main": { "$ref": "#/$defs/cabin" },
                  "premier": { "type": "null" }
                }
              },
              {
                "properties": {
                  "main": { "type": "null" },
                  "premier": { "$ref": "#/$defs/cabin" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "job": { "properties": { "status": { "const": "error" } } } } },
      "then": {
        "properties": {
          "job": {
            "properties": {
              "error": { "type": "string", "minLength": 1 },
              "main": { "type": "null" },
              "premier": { "type": "null" }
            }
          }
        }
      }
    }
  ]
}
