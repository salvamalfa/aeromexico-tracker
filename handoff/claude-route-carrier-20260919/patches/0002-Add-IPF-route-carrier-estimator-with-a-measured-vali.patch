+    seed = np.array([[5.0, 4.0, 0.0], [3.0, 3.0, 1.0], [0.0, 0.0, 2.0]])
+    rows, columns = _margins(TRUTH)
+    rescaled = seed * np.array([180.0, 220.0, 99.0])[None, :]
