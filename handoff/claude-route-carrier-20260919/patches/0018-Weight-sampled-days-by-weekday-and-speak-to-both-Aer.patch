+            + ", ".join(f"{d:%a}x{w:.2f}" for d, w in sorted(weights.items()))
+        )
     flights, stats = pull_days(
         airports, days, period_id=args.period_id,
-        cache_dir=args.cache_dir, unit_budget=args.budget,
