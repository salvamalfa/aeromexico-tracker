# Build a deliberately small public runtime image. Add an explicit negation
# below only when the chat backend needs another tracked, non-secret file.
**
!Dockerfile.chat
!pyproject.toml
!uv.lock
!scripts/
!scripts/start_chat_runtime.py
!scripts/chat/
!scripts/chat/reconcile_failed_turn.py

!src/
!src/__init__.py
!src/config.py
!src/conversational_analytics/
