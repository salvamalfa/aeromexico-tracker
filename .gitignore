# Compact, validated gold Parquets are versioned for the public dashboard.
# The paid-provider route-carrier cube stays in the private data repository;
# only its bounded Aeromexico display extract is embedded in generated HTML.
data/gold/fact_route_carrier_domestic_estimate.parquet
data/gold/fact_aeromexico_domestic_capacity_estimate.parquet
data/gold/fact_route_carrier_international_estimate.parquet
data/gold/fact_aeromexico_international_capacity_estimate.parquet
data/quality/
data/analytics/
data/*.duckdb
data/*.duckdb.wal

# Serialized estimators stay local; metadata and evaluation receipts are versioned.
models/*/model.pkl

# Local dashboard/runtime state.
.streamlit/secrets.toml

# Authoritative local analysis runs; never published as dashboard data.
analysis_runs/
