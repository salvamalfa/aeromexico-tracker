# Build-time settings for the published site (read by `vite build`, so also by
# src.publish). The API URL is already public in access.html; it is not a secret.
# Keep VITE_CHAT_ENABLED=false until OpenAI is enabled on Railway, then set it to
# true, run src.publish with the approved record and ship site/ in a PR
# (docs/chat/railway.md, "Activación del MVP"). Explicit environment variables
# still override these values (the browser smoke tests rely on that).
VITE_CHAT_ENABLED=false
VITE_CHAT_API_URL=https://aeromexico-tracker-production.up.railway.app/api/chat
