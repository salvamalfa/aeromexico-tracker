FROM ghcr.io/astral-sh/uv:0.12.19 AS uv

FROM python:3.13-slim AS build
COPY --from=uv /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
# CI validates the full lock with --locked. --frozen installs this isolated
# profile without resolving metadata for unrelated project extras.
RUN uv sync --frozen --only-group chat-runtime --no-install-project

FROM python:3.13-slim AS runtime
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CHAT_PROVIDER=mock \
    CHAT_ADMISSION_ENABLED=false \
    CHAT_RETENTION_DAYS=30 \
    CHAT_STATE_PATH=/data/chat.sqlite3
WORKDIR /app
COPY --from=build /opt/venv /opt/venv

# These explicit copies are the complete import and data closure for the API.
# In particular, no private warehouse, analysis_runs, .env, or tests enter the image.
COPY src/__init__.py src/config.py ./src/
COPY src/conversational_analytics/ ./src/conversational_analytics/
COPY src/web_export/ ./src/web_export/
COPY src/publish/__init__.py src/publish/manifest.py ./src/publish/
COPY src/dashboard/__init__.py src/dashboard/flights_html.py ./src/dashboard/
# Copy only the runtime configuration. Candidate evidence and collection
# inboxes stay out of the image; approval receipts bind the exact owner-reviewed inputs.
COPY config/chat/*.yaml ./config/chat/
COPY config/chat/models.json config/chat/metrics-candidates.json config/chat/business-metrics-proposal.json ./config/chat/
COPY config/chat/system_prompt.txt ./config/chat/system_prompt.txt
COPY config/chat/evidence/approved-index.json ./config/chat/evidence/approved-index.json
COPY config/chat/prompt_candidates/system_prompt_r2-proposed.txt ./config/chat/prompt_candidates/
COPY config/chat/prompt_candidates/system_prompt_r2-proposed.json ./config/chat/prompt_candidates/
COPY config/chat/prompt_approval.json ./config/chat/
COPY contracts/chat/*.schema.json ./contracts/chat/
COPY contracts/web/*.json contracts/web/privacy.yaml ./contracts/web/
# The approved baseline still pins this exact historical flights schema.
COPY contracts/web/versions/17fb7e131da94435190bea925fe9733e298754d04e9b9c5e76fbbea8bef119a7/flights.schema.json ./contracts/web/versions/17fb7e131da94435190bea925fe9733e298754d04e9b9c5e76fbbea8bef119a7/
COPY contracts/web/versions/15768d277f9cb31d361d2b976602e4b65e7ed20d6419a38699557b0c13aafef6/flights.schema.json ./contracts/web/versions/15768d277f9cb31d361d2b976602e4b65e7ed20d6419a38699557b0c13aafef6/
COPY contracts/web/versions/c0e3b0fb5e3f840087bbb3bed0e222e477f90f5dc9ab9840802916f1ed5eb8c2/analysis.schema.json ./contracts/web/versions/c0e3b0fb5e3f840087bbb3bed0e222e477f90f5dc9ab9840802916f1ed5eb8c2/
COPY contracts/web/versions/3ac4a80fbeadea2b6c4eea6ee6d906acf24b1cf1202b295bde0b86b32b2d0008/market.schema.json ./contracts/web/versions/3ac4a80fbeadea2b6c4eea6ee6d906acf24b1cf1202b295bde0b86b32b2d0008/
COPY contracts/web/versions/420bdc05ef4035fe2f99a5e6e5fce3b0d4d5129abdfefa298a78a1c620dc95bf/market_demand.schema.json ./contracts/web/versions/420bdc05ef4035fe2f99a5e6e5fce3b0d4d5129abdfefa298a78a1c620dc95bf/
COPY contracts/web/versions/6b5626c10552c7a3af385a6aa6a251fadef31f0e317067c6532869a9c0a96721/flights.schema.json ./contracts/web/versions/6b5626c10552c7a3af385a6aa6a251fadef31f0e317067c6532869a9c0a96721/
COPY contracts/web/versions/3eb5e9425dd346a38088ddef500ff0ff5f71d62dad6559bba7b486135f8ccc58/flights.schema.json ./contracts/web/versions/3eb5e9425dd346a38088ddef500ff0ff5f71d62dad6559bba7b486135f8ccc58/
COPY site/publication_manifest.json ./site/
COPY site/data/v1/ ./site/data/v1/
COPY scripts/start_chat_runtime.py ./scripts/start_chat_runtime.py
COPY scripts/chat/reconcile_failed_turn.py ./scripts/chat/reconcile_failed_turn.py

RUN mkdir -p /data && chmod 0700 /data
EXPOSE 8080
CMD ["python", "-m", "scripts.start_chat_runtime"]
