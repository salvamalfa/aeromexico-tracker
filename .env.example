# Required. SEC fair-access policy requires an identifiable User-Agent with a
# real, monitored contact address.
SEC_USER_AGENT="Aeromexico Tracker your-email@example.com"

# Free token: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=""

# Optional. FRED can be used instead of EIA where an equivalent series exists.
EIA_API_KEY=""
FRED_API_KEY=""

# Optional. Seed source for the route-carrier estimator (flights per carrier per
# route per month). Free for non-commercial use; the account has to be created
# by hand because registration is behind a CAPTCHA.
# Create the account at opensky-network.org, then generate an API client from
# the account page and paste the pair here.
OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""
# Fallback if the account page offers no API client and only basic auth works.
OPENSKY_USERNAME=""
OPENSKY_PASSWORD=""
