# Required. SEC fair-access policy requires an identifiable User-Agent with a
# real, monitored contact address.
SEC_USER_AGENT="Aeromexico Tracker your-email@example.com"

# Free token: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=""

# Optional. FRED can be used instead of EIA where an equivalent series exists.
EIA_API_KEY=""
FRED_API_KEY=""

# Optional. Seed source for the route-carrier estimator (flights per carrier per
# route per month). Free for non-commercial use; the account has to be created
# by hand because registration is behind a CAPTCHA.
# OpenSky moved to OAuth2 client credentials exclusively — username/password no
# longer authenticates. Generate an API client from the account settings page at
# opensky-network.org and paste the pair here. Tokens expire every 30 minutes
# and are refreshed by the client, so nothing else needs storing.
OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""

# AeroDataBox via RapidAPI: the estimator's seed (published schedules).
# The free Basic tier gives 400 API units a month; a FIDS call costs 2.
RAPIDAPI_KEY=
