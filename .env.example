# Required. SEC fair-access policy requires an identifiable User-Agent with a
# real, monitored contact address.
SEC_USER_AGENT="Aeromexico Tracker your-email@example.com"

# Free token: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=""

# Optional. FRED can be used instead of EIA where an equivalent series exists.
EIA_API_KEY=""
FRED_API_KEY=""
